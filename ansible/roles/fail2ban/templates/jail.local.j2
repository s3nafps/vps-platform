# Managed by Ansible (vps-platform fail2ban role).
[DEFAULT]
backend = systemd
banaction = ufw
bantime = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}

[sshd]
enabled = true
port = {{ ssh_port }}

# Repeat offenders get banned for a week.
[recidive]
enabled = true
backend = auto
logpath = /var/log/fail2ban.log
bantime = 1w
findtime = 1d
maxretry = 3
